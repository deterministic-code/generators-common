{
  "name": "@deterministic-code/generators-common",
  "version": "0.0.1",
  "description": "Shared generator helpers: reader, entries, routes-api, and template fill.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deterministic-code/generators-common.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./base-type-converter": {
      "types": "./src/base-type-converter.ts",
      "import": "./dist/base-type-converter.js"
    },
    "./casing-strategy": {
      "types": "./src/casing-strategy.ts",
      "import": "./dist/casing-strategy.js"
    },
    "./datasource-type-tree": {
      "types": "./src/datasource-type-tree.ts",
      "import": "./dist/datasource-type-tree.js"
    },
    "./default-token": {
      "types": "./src/default-token.ts",
      "import": "./dist/default-token.js"
    },
    "./deterministic-reader": {
      "types": "./src/deterministic-reader.ts",
      "import": "./dist/deterministic-reader.js"
    },
    "./fill": {
      "types": "./src/fill.ts",
      "import": "./dist/fill.js"
    },
    "./generate-context": {
      "types": "./src/generate-context.ts",
      "import": "./dist/generate-context.js"
    },
    "./generate-entry": {
      "types": "./src/generate-entry.ts",
      "import": "./dist/generate-entry.js"
    },
    "./import-generator": {
      "types": "./src/import-generator.ts",
      "import": "./dist/import-generator.js"
    },
    "./reference-verifier": {
      "types": "./src/reference-verifier.ts",
      "import": "./dist/reference-verifier.js"
    },
    "./routes-api": {
      "types": "./src/routes-api.ts",
      "import": "./dist/routes-api.js"
    },
    "./routes-api-converter": {
      "types": "./src/routes-api-converter.ts",
      "import": "./dist/routes-api-converter.js"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./dist/settings.js"
    },
    "./spec-types": {
      "types": "./src/spec-types.ts",
      "import": "./dist/spec-types.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.build.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --experimental-strip-types --test src/routes-api-converter.test.ts src/casing-strategy.test.ts src/settings.test.ts src/reference-verifier.test.ts src/datasource-type-tree.test.ts"
  },
  "dependencies": {
    "@deterministic-code/deterministic-specifications-typescript": "github:deterministic-code/deterministic-specifications-typescript#main",
    "@types/mustache": "^4.2.6",
    "@types/pluralize": "^0.0.33",
    "mustache": "^4.2.0",
    "pluralize": "^8.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
